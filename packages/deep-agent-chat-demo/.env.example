# Gemini API mode (M1 default)
DEEP_AGENT_MODEL_BACKEND=gemini-api
DEEP_AGENT_MODEL=gemini-3.1-flash-lite
DEEP_AGENT_TEMPERATURE=0
DEEP_AGENT_MAX_OUTPUT_TOKENS=8192
GEMINI_API_KEY=
# GOOGLE_API_KEY=  # alternative accepted by Google client libraries
# Optional: set to true to load Context7 MCP in execute phase
DEEP_AGENT_ENABLE_CONTEXT7=false
DEEP_AGENT_MCP_TIMEOUT_MS=5000
